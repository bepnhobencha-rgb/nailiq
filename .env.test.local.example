# Copy to `.env.test.local` (ignored by git). Loaded with override=true during
# `npx playwright test` (playwright.config.ts), so these win over .env.local.
# They do NOT affect your normal `npm run dev` session.
#
# ⚠️ These MUST point at a DEDICATED TEST Supabase project — never production.
#
# E2E used to run against the one production project, and it left five
# `*.test.invalid` superadmin accounts (two of them active `founder`) and a pile
# of `e2e-*` fixture salons living next to real customer data. It now refuses to
# start unless pointed elsewhere: e2e/helpers/guardProduction.ts checks the
# Supabase project ref and the hostname, and fails CLOSED when it cannot tell
# which database it is holding a service-role key for.
#
# See docs/E2E-TEST-DATABASE.md to stand one up.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The TEST project's values (Dashboard → test project → Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The TEST project's ref — the 20 characters in https://<ref>.supabase.co.
# Pins the run to exactly one project. A service-role key WITHOUT this pin is a
# hard error, not a warning: an unpinned run is how production got written to.
E2E_EXPECTED_PROJECT_REF=
NEXT_PUBLIC_DEMO_OTP=true
DEMO_OTP=true
# Allows E2E fixture slugs (e2e-receptionist-center, e2e-dashboard-salon, etc.)
# to work with the demo cookie. NEVER set to 1 on production.
NAILIQ_TEST_BYPASS_SLUG_PIN=1
# HARD kill-switch: E2E must never bill real Twilio SMS/Verify. NEVER set on production.
DISABLE_OUTBOUND_SMS=1
PLAYWRIGHT_BASE_URL=http://localhost:3000
