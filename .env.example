# Copy to `.env.local`. Never commit real secrets.

# ─── App ───────────────────────────────────────────────────────────────
# Canonical site origin (no trailing slash). Required for SSR URLs,
# sitemap, booking confirmation email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same as NEXT_PUBLIC_SITE_URL but used server-side (in email helpers etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Internal API ──────────────────────────────────────────────────────
# Shared secret for internal server-to-server API calls (e.g. /api/booking-email).
# Generate with: openssl rand -hex 24
INTERNAL_API_SECRET=

# ─── Resend (email) ────────────────────────────────────────────────────
# Required in production. Missing in dev → emails are silently skipped.
RESEND_API_KEY=re_...
# From address must match a verified Resend domain.
# Format: "Display Name <address@yourdomain.com>"
RESEND_FROM=NailIQ <noreply@nailiq.ca>

# ─── Twilio (SMS OTP + SMS reminders) ─────────────────────────────────
# Shared credentials for both Twilio Verify (OTP) and Messages API (reminders).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Required for SMS OTP (phone_otp_enabled per salon):
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required for SMS reminders (sms_reminders_enabled per salon):
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Stripe (payments) ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Subscription plan price IDs (create in Stripe Dashboard → Products).
# Pro = $39 CAD/month, Studio = $99 CAD/month.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# ─── Anthropic (AI features: no-show risk score + personalized reminders) ──
ANTHROPIC_API_KEY=sk-ant-...

# ─── Vercel Cron (reminder scheduler) ──────────────────────────────────
# Generate with: openssl rand -hex 24
CRON_SECRET=

# ─── Sentry (error monitoring) ─────────────────────────────────────────
SENTRY_ORG=
SENTRY_PROJECT=
# Optional: enable source map uploads in CI
# SENTRY_AUTH_TOKEN=

# ─── Vercel (auto-injected in deployment, only needed locally) ─────────
# VERCEL_URL is auto-set by Vercel; override here only for local testing
# VERCEL_URL=your-project.vercel.app

# ─── OpenAI (Voice AI booking) ───────────────────────────────────────
OPENAI_API_KEY=
