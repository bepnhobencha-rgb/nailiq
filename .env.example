# Copy to `.env.local`. Never commit real secrets.

# ─── App ───────────────────────────────────────────────────────────────
# Canonical site origin (no trailing slash). Required for SSR URLs,
# sitemap, booking confirmation email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same as NEXT_PUBLIC_SITE_URL but used server-side (in email helpers etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase for E2E (a SEPARATE project — never production) ──────────
# E2E used to run against the production project and left five superadmin
# accounts and a pile of fixture salons sitting next to real customer data.
# It now refuses to run unless it is pointed at a dedicated test project.
# See docs/E2E-TEST-DATABASE.md for how to stand one up.
#
# In CI these are repo SECRETS (TEST_SUPABASE_URL / _ANON_KEY /
# _SERVICE_ROLE_KEY) plus one repo VARIABLE (TEST_SUPABASE_PROJECT_REF).
# Locally, put the test project's values in .env.test.local instead.
#
# E2E_EXPECTED_PROJECT_REF pins the run to exactly one project ref. A
# service-role key WITHOUT this pin is a hard error, not a warning: an
# unpinned database run is how the production project got written to.
E2E_EXPECTED_PROJECT_REF=

# ─── Internal API ──────────────────────────────────────────────────────
# Shared secret for internal server-to-server API calls (e.g. /api/booking-email).
# Generate with: openssl rand -hex 24
INTERNAL_API_SECRET=

# Signs consent + review-rating magic links (/v/[token], /api/customer/*).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Resend (email) ────────────────────────────────────────────────────
# Required in production. Missing in dev → emails are silently skipped.
RESEND_API_KEY=re_...
# From address must match a verified Resend domain.
# Format: "Display Name <address@yourdomain.com>"
RESEND_FROM=NailIQ <noreply@nailiq.ca>

# ─── Twilio (SMS OTP + SMS reminders) ─────────────────────────────────
# Shared credentials for both Twilio Verify (OTP) and Messages API (reminders).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Required for SMS OTP (phone_otp_enabled per salon):
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required for SMS reminders (sms_reminders_enabled per salon):
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# KILL-SWITCH: set to 1 in CI/test/dev to suppress ALL outbound SMS/OTP
# (log + fake SID, no real Twilio call). Leave UNSET/empty on production —
# setting it on prod disables SMS for real customers. (555-exchange seed
# numbers are blocked automatically even on prod, regardless of this flag.)
DISABLE_OUTBOUND_SMS=

# ─── Stripe (payments) ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Subscription plan price IDs (create in Stripe Dashboard → Products).
# Pro = $39 CAD/month, Studio = $99 CAD/month.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# ─── Anthropic (AI features: no-show risk score + personalized reminders) ──
ANTHROPIC_API_KEY=sk-ant-...

# ─── Vercel Cron (reminder scheduler) ──────────────────────────────────
# Generate with: openssl rand -hex 24
CRON_SECRET=

# ─── Wix integration ───────────────────────────────────────────────────
WIX_API_KEY=
# Shared secret for verifying Wix webhook HMAC-SHA256 signatures.
# Generate with: openssl rand -hex 32
# Leave blank during initial setup (verification is skipped when unset).
# Wix custom app public key (PEM format) from Wix Dev Console → App → Webhooks
# Used to verify RSA-SHA256 signatures on incoming webhook events
# Generate/find at: https://dev.wix.com → Your App → Webhooks → Public Key
WIX_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...paste PEM key here...
-----END PUBLIC KEY-----"

# ─── Sentry (error monitoring) ─────────────────────────────────────────
# Public DSN — required for client/server/edge error reporting to initialize.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional: enable source map uploads in CI
# SENTRY_AUTH_TOKEN=

# ─── Vercel (auto-injected in deployment, only needed locally) ─────────
# VERCEL_URL is auto-set by Vercel; override here only for local testing
# VERCEL_URL=your-project.vercel.app

# ─── OpenAI (Voice AI booking) ───────────────────────────────────────
OPENAI_API_KEY=
# Optional overrides — defaults in src/config/realtime.ts are the confirmed-working values.
# Only set these if you need to test a different model/voice.
# OPENAI_REALTIME_MODEL=gpt-realtime-2025-08-28
# OPENAI_REALTIME_VOICE=shimmer
# Safe mode: disable all tools → connect+listen+speak only (debug raw connection first)
# NEXT_PUBLIC_VOICE_SAFE_MODE=1
